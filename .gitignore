# dependencies
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# build output
dist/
dist-worker/
build/
*.tsbuildinfo

# env / secrets
.env
.env.*
.dev.vars
!.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# uploads (local file storage)
backend/storage/

# graphify generated caches / timestamped backups
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-*/

# Expo / React Native generated native projects (regenerate with `expo prebuild`)
.expo/
frontend/.expo/
frontend/ios/
frontend/android/

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/
frontend/.auth/

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# local iOS release artifacts
ios/
build/
*.ipa
