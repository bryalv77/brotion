// Notion Clone — Prisma schema.
//
// Task 3 adds workspaces, membership, pages (tree), blocks, attachments, and
// the search-text denormalization. Sharing/comments/permissions land in Task 4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ShareType {
  USER
  PUBLIC_LINK
}

enum PageAccess {
  OWNER
  EDITOR
  VIEWER
}

enum PropertyType {
  text
  number
  select
  multi_select
  status
  date
  checkbox
  url
  formula
  relation
  rollup
  created_time
  created_by
  last_edited_time
  last_edited_by
}

enum BlockType {
  paragraph
  heading1
  heading2
  heading3
  bulleted_list_item
  numbered_list_item
  todo
  quote
  callout
  divider
  code
  image
  table
  table_row
  page_ref
}

enum ViewType {
  table
  list
  board
  gallery
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  name          String?
  avatar_url    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  sessions          Session[]
  workspace_members WorkspaceMember[]
  workspaces        Workspace[]       @relation("WorkspaceCreatedBy")
  pages             Page[]            @relation("PageCreatedBy")
  pages_updated     Page[]            @relation("PageLastUpdatedBy")
  attachments       Attachment[]
  page_permissions  PagePermission[]
  comments          Comment[]

  @@map("users")
}

model Session {
  id                 String    @id @default(cuid())
  user_id            String
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_token_hash String
  expires_at         DateTime
  created_at         DateTime  @default(now())
  revoked_at         DateTime?

  @@index([user_id])
  @@index([refresh_token_hash])
  @@map("sessions")
}

model Workspace {
  id         String   @id @default(cuid())
  name       String
  icon       String?
  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  creator   User              @relation("WorkspaceCreatedBy", fields: [created_by], references: [id])
  members   WorkspaceMember[]
  pages     Page[]
  databases Database[]

  @@map("workspaces")
}

model WorkspaceMember {
  id           String        @id @default(cuid())
  workspace_id String
  user_id      String
  role         WorkspaceRole
  created_at   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id])
  @@map("workspace_members")
}

model Page {
  id              String    @id @default(cuid())
  workspace_id    String
  parent_id       String?
  title           String    @default("")
  icon            String?
  cover_url       String?
  content_text    String    @default("") // denormalized text for full-text search
  is_deleted      Boolean   @default(false)
  deleted_at      DateTime?
  deleted_by      String?
  // True for the hidden Page that backs a Database Template: it is never shown
  // in the sidebar tree, search results, or breadcrumbs. Excluded by the
  // `is_template: false` filter in those read paths.
  is_template     Boolean   @default(false)
  created_by      String
  last_updated_by String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  // Manual ordering of database rows. Null for non-row pages (which use
  // created_at); row pages set this on creation and on drag-reorder.
  row_order       Float?

  workspace       Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  parent          Page?            @relation("PageTree", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        Page[]           @relation("PageTree")
  blocks          Block[]
  created         User             @relation("PageCreatedBy", fields: [created_by], references: [id])
  updator         User?            @relation("PageLastUpdatedBy", fields: [last_updated_by], references: [id])
  permissions     PagePermission[]
  comments        Comment[]
  database_row    Database?        @relation("PageDatabaseRow", fields: [database_id], references: [id], onDelete: SetNull)
  databases       Database[]       @relation("DatabaseHostPage")
  property_values PropertyValue[]

  // This page belongs to a Database as a row.
  database_id String?

  // The Template (if any) whose block body this hidden page holds. Null for
  // every normal page; 1:1 with Template.page_id.
  template_body Template? @relation("TemplateBodyPage")

  @@index([workspace_id])
  @@index([parent_id])
  @@index([is_deleted])
  @@map("pages")
}

model Block {
  id              String    @id @default(cuid())
  page_id         String
  parent_block_id String?
  type            BlockType
  content         Json
  order           Float
  created_by      String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  page     Page    @relation(fields: [page_id], references: [id], onDelete: Cascade)
  parent   Block?  @relation("BlockTree", fields: [parent_block_id], references: [id], onDelete: Cascade)
  children Block[] @relation("BlockTree")

  @@index([page_id])
  @@index([parent_block_id])
  @@index([page_id, order])
  @@map("blocks")
}

model Attachment {
  id          String   @id @default(cuid())
  user_id     String
  page_id     String?
  block_id    String?
  file_name   String
  mime_type   String
  size_bytes  Int
  storage_key String
  url         String
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([page_id])
  @@map("attachments")
}

model PagePermission {
  id         String     @id @default(cuid())
  page_id    String
  user_id    String?
  share_type ShareType
  access     PageAccess
  inherit    Boolean    @default(true)
  token      String?    @unique
  created_at DateTime   @default(now())

  page Page  @relation(fields: [page_id], references: [id], onDelete: Cascade)
  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([page_id])
  @@map("page_permissions")
}

model Comment {
  id         String   @id @default(cuid())
  block_id   String
  page_id    String
  user_id    String
  body       Json
  resolved   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  page Page @relation(fields: [page_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([block_id])
  @@index([page_id])
  @@map("comments")
}

model Database {
  id           String   @id @default(cuid())
  workspace_id String
  page_id      String
  title        String   @default("")
  icon         String?
  created_by   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace        Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  page             Page           @relation("DatabaseHostPage", fields: [page_id], references: [id], onDelete: Cascade)
  rows             Page[]         @relation("PageDatabaseRow")
  properties       Property[]
  views            DatabaseView[]
  templates        Template[]
  // Relation properties in other (or this) databases that point here.
  relation_sources Property[]     @relation("RelationTarget")

  @@index([page_id])
  @@map("databases")
}

model DatabaseView {
  id          String   @id @default(cuid())
  database_id String
  name        String   @default("Table")
  type        ViewType
  // { filters: Filter[], sorts: Sort[], group_by?: string, hidden?: string[] }
  config      Json     @default("{}")
  order       Int      @default(0)
  created_at  DateTime @default(now())

  database Database @relation(fields: [database_id], references: [id], onDelete: Cascade)

  @@index([database_id])
  @@map("database_views")
}

model Property {
  id                   String       @id @default(cuid())
  database_id          String
  name                 String
  type                 PropertyType
  options              Json?
  // For `relation` properties: the target database id (self-relation across
  // databases in the same workspace). Null for all other types.
  relation_database_id String?
  // For `rollup` properties: { relation_property_id, target_property_id, aggregation }.
  rollup_config        Json?
  order                Int          @default(0)
  created_at           DateTime     @default(now())

  database    Database        @relation(fields: [database_id], references: [id], onDelete: Cascade)
  values      PropertyValue[]
  // Self-reference: a relation property points at another database.
  relation_db Database?       @relation("RelationTarget", fields: [relation_database_id], references: [id], onDelete: SetNull)

  @@index([database_id])
  @@index([relation_database_id])
  @@map("properties")
}

model PropertyValue {
  id          String   @id @default(cuid())
  page_id     String
  property_id String
  value       Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  page     Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  property Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@unique([page_id, property_id])
  @@index([page_id])
  @@map("property_values")
}

// A Template is a factory that produces new database rows (Pages) by deep-copy.
// Its block body lives on a hidden Page (is_template=true); applying a template
// copies that body + the default_values onto a freshly created row. Once
// instantiated, the row is fully independent of the template (no sync).
model Template {
  id             String   @id @default(cuid())
  database_id    String
  name           String   @default("")
  icon           String?
  // The hidden Page (is_template=true) that stores the template's block tree.
  page_id        String   @unique
  // Initial property values applied on instantiation: { property_id: value }.
  // Only editable property types are stored (formula/rollup/system are skipped).
  default_values Json     @default("{}")
  is_default     Boolean  @default(false)
  created_by     String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  database Database @relation(fields: [database_id], references: [id], onDelete: Cascade)
  page     Page     @relation("TemplateBodyPage", fields: [page_id], references: [id], onDelete: Cascade)

  @@index([database_id])
  @@map("templates")
}
