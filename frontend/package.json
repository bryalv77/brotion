{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "release:ios": "node scripts/release-ios.mjs",
    "android": "expo run:android",
    "build:web": "expo export --platform web && node scripts/prepare-pages.js",
    "typecheck": "tsc --noEmit",
    "test:api": "playwright test --config playwright.api.config.ts",
    "test:e2e": "playwright test --config playwright.web.config.ts",
    "e2e:server:backend": "pnpm --filter backend build && NODE_ENV=test pnpm --filter backend start",
    "e2e:server:frontend": "CI=1 EXPO_PUBLIC_API_URL=http://127.0.0.1:4000 expo start --web --port 8092"
  },
  "dependencies": {
    "@expo/metro-runtime": "*",
    "@notion-clone/shared": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~58.0.25",
    "expo-constants": "*",
    "expo-document-picker": "*",
    "expo-file-system": "*",
    "expo-image-picker": "*",
    "expo-linking": "*",
    "expo-router": "~58.0.31",
    "expo-secure-store": "*",
    "expo-sharing": "*",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "*",
    "idb": "^8.0.4",
    "lucide-react-native": "^1.74.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.3",
    "workbox-build": "^7.4.1"
  }
}
