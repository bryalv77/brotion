{
  "name": "notion-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "pnpm --filter frontend web",
    "dev:backend": "pnpm --filter backend dev",
    "web": "pnpm --filter frontend web",
    "ios": "pnpm --filter frontend ios",
    "android": "pnpm --filter frontend android",
    "build": "pnpm -r build",
    "start": "pnpm --filter backend start",
    "migrate": "pnpm --filter backend prisma:migrate",
    "seed": "pnpm --filter backend prisma:seed",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "pnpm -r typecheck",
    "test:api": "pnpm --filter frontend test:api",
    "test:e2e": "pnpm --filter frontend test:e2e"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.18.0"
}
