{
  "name": "@notion-clone/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api-types": {
      "types": "./dist/api-types.d.ts",
      "import": "./dist/api-types.js"
    },
    "./block-schema": {
      "types": "./dist/block-schema.d.ts",
      "import": "./dist/block-schema.js"
    },
    "./formulas": {
      "types": "./dist/formulas/index.d.ts",
      "import": "./dist/formulas/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test \"formulas/*.test.ts\" \"./*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
